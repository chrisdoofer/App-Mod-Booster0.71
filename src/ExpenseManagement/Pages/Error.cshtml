@page
@model ExpenseManagement.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6">
        <div class="card shadow border-0">
            <div class="card-body text-center p-5">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                <h1 class="display-6 fw-bold mt-3 mb-2">Something went wrong</h1>
                <p class="text-muted mb-4">
                    An error occurred while processing your request.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light text-start mb-4">
                        <strong>Request ID:</strong>
                        <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-page="/Index" class="btn btn-primary">
                        <i class="bi bi-house me-1"></i>Return to Dashboard
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Go Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
